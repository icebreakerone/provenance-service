FROM python:3.13-alpine
COPY . /app
WORKDIR /app
RUN apk add uv --no-cache
RUN uv sync --no-group dev --group deployment --locked
ENV PATH="/app/.venv/bin:$PATH"
RUN ls -al
EXPOSE 8080
# pip uninstall -y ib1-provenance && pip install -e provenance && 
CMD ["/bin/sh", "-c", "uv pip uninstall ib1-provenance && uv pip install -e provenance --no-deps && uvicorn main:app --host 0.0.0.0 --port 8080 --log-level info --access-log"]
